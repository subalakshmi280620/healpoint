PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/healpoint_test
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=12h
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
# Optional comma-separated trusted proxy IPs/CIDR ranges, not a hop count; leave blank to ignore forwarded IP headers.
# Configure only the ingress proxy addresses and restrict direct access to the API server.
TRUSTED_PROXY_IPS=
